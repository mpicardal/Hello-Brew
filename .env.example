# Copy to .env (setup.php does this for you). Never commit .env.
APP_ENV=development
# Leave empty when using "php -S" or a virtual host. For XAMPP at http://localhost/hello-brew/public use:
# APP_BASE=/hello-brew/public
APP_BASE=
APP_SECRET=
# Address customers use to open the site (used for "Track your order" links in emails)
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hello_brew
DB_USER=root
DB_PASS=

# Emails are always saved in the admin "Email log".
#   log  = saved only (no real email is sent)
#   smtp = also really sent through Gmail (fill in the 4 SMTP lines below)
MAIL_TRANSPORT=log
MAIL_FROM=hello@hellobrew.local

# Gmail: SMTP_USER is the full Gmail address, SMTP_PASS is a 16-letter App Password
# (Google Account > Security > 2-Step Verification > App passwords). Never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CAFE_EMAIL=hello@hellobrew.local
CAFE_PHONE=+63 917 555 0142
CAFE_ADDRESS=88 Kapitolyo Drive, Pasig City, Metro Manila
