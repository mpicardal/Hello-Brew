# Copy to .env (setup.php does this for you). Never commit .env.
APP_ENV=development
# Leave empty when using "php -S" or a virtual host. For XAMPP at http://localhost/hello-brew/public use:
# APP_BASE=/hello-brew/public
APP_BASE=
APP_SECRET=
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hello_brew
DB_USER=root
DB_PASS=

# "log" stores emails in the admin Email log only. "mail" also sends them with PHP mail().
MAIL_TRANSPORT=log
MAIL_FROM=hello@hellobrew.local

CAFE_EMAIL=hello@hellobrew.local
CAFE_PHONE=+63 917 555 0142
CAFE_ADDRESS=88 Kapitolyo Drive, Pasig City, Metro Manila
