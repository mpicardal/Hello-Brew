# Uploaded files are images only: never run scripts from here.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?!(jpe?g|png|webp)$)[^.]+$">
  Require all denied
</FilesMatch>
